<script>
const D=JSON.parse(document.getElementById('data').textContent),R=['home','about','portfolio','services','contact'],C=['poster','graphic','social','logo','illus','other'];
const WA='https://wa.me/6285861493020',IG='https://instagram.com/yanzdesign2010',EM='yanzdesign2010@gmail.com';
let S=JSON.parse(JSON.stringify(D)),lang='id',edit=false,owner=false,flt='all',open=false,arm=-1,st='',stErr=false;
try{lang=localStorage.getItem('l')==='en'?'en':'id'}catch(e){}
const app=document.getElementById('app'),md=document.getElementById('md'),bar_=document.getElementById('bar');
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const t=k=>S.t[lang][k]??'';
const E=(k,tag='span',c='')=>`<${tag} class="${c}" data-k="${k}">${esc(t(k))}</${tag}>`;
const IM=(k,c)=>S.img[k]?`<img class="${c}" src="${esc(S.img[k])}" alt="Yanzdesign2010" data-img="${k}">`:`<div class="${c} ph" data-img="${k}"><span>${esc(t('ph'))}</span></div>`;
const PC=(p,i)=>`<article class="card reveal" data-i="${i}">${p.img?`<img src="${esc(p.img)}" alt="${esc(p.title)}" loading="lazy" data-pimg="${i}">`:`<div class="ph" data-pimg="${i}"><span>${esc(t('ph'))}</span></div>`}<div class="cb"><small>${esc(t('c_'+p.cat))} · <span data-pp="${i}.year">${esc(p.year)}</span></small><h3 data-pp="${i}.title">${esc(p.title)}</h3><p data-pp="${i}.desc">${esc(p.desc)}</p>${edit?`<div class="ed"><select data-pc="${i}">${C.map(c=>`<option value="${c}"${c==p.cat?' selected':''}>${esc(t('c_'+c))}</option>`).join('')}</select><button data-mv="${i},-1">↑</button><button data-mv="${i},1">↓</button><button data-del="${i}">${arm===i?'Yakin hapus?':'🗑'}</button></div>`:''}</div></article>`;
const V={
home:()=>`<section class="hero"><div><p class="kick">${E('tag')}</p>${E('hero_h','h1')}<p class="lead">${E('hero_s')}</p><div class="btns"><a class="btn" href="#portfolio">${E('explore')}</a><a class="btn o" href="#contact">${E('cm')}</a></div></div>${IM('profile','pf')}</section>
<section><h2>${E('feat')}</h2><div class="grid">${S.p.slice(0,3).map(PC).join('')}</div></section>
<section class="cta"><h2>${E('contact_t')}</h2><a class="btn" href="#contact">${esc(t('talk'))}</a></section>`,
about:()=>`<section class="two"><div>${E('about_t','h2')}<p>${E('about_d')}</p><h3 style="margin-top:28px">${E('story_t')}</h3><p style="color:var(--t2)">${E('story_d')}</p><h3 style="margin-top:20px">${E('phil_t')}</h3><p style="color:var(--t2)">${E('phil_d')}</p></div>${IM('profile','pf')}</section>
<section><h2>${E('sw_t')}</h2><div class="grid"><div class="card sv"><div class="cb"><h3>Alight Motion</h3><p>${E('sw1_d')}</p></div></div><div class="card sv"><div class="cb"><h3>Canva</h3><p>${E('sw2_d')}</p></div></div></div></section>`,
portfolio:()=>`<section>${E('port_t','h2')}<p class="lead">${E('port_s')}</p><div class="fl">${['all',...C].map(c=>`<button data-f="${c}" class="${flt==c?'on':''}">${esc(t(c=='all'?'all':'c_'+c))}</button>`).join('')}</div><div class="grid">${S.p.map((p,i)=>flt=='all'||p.cat==flt?PC(p,i):'').join('')}</div></section>`,
services:()=>`<section>${E('svc_t','h2')}<div class="grid">${[1,2,3,4,5].map(n=>`<div class="card sv reveal"><div class="cb"><div class="ic">${['🎨','🖼️','📱','✦','💡'][n-1]}</div>${E('s'+n+'_n','h3')}<p>${E('s'+n+'_d')}</p><p><a class="btn o" href="#contact" style="margin-top:8px">${E('disc')}</a></p></div></div>`).join('')}</div></section>`,
contact:()=>`<section class="two"><div>${E('contact_t','h2')}<p class="lead">${E('contact_d')}</p><div class="btns"><a class="btn" href="${WA}" target="_blank" rel="noopener">WhatsApp</a><a class="btn o" href="${IG}" target="_blank" rel="noopener">Instagram</a><a class="btn o" href="mailto:${EM}">Email</a></div></div>
<form id="cf" novalidate><label>${E('f_name')}</label><input name="n" autocomplete="name"><label>${E('f_email')}</label><input name="e" type="email" autocomplete="email"><label>${E('f_msg')}</label><textarea name="m" rows="5"></textarea><button class="btn" type="submit">${E('send')}</button><p id="fs" aria-live="polite"></p></form></section>`};
function render(){
 const cur=R.includes(location.hash.slice(1))?location.hash.slice(1):'home';
 document.documentElement.lang=lang;
 const logo=S.img.logo?`<img src="${esc(S.img.logo)}" alt="Yanzdesign2010" data-img="logo">`:`<span data-img="logo">YANZDESIGN<b>2010</b></span>`;
 app.innerHTML=`<header><div class="nv"><a class="lg" href="#home">${logo}</a><nav class="${open?'open':''}">${R.map(r=>`<a href="#${r}" class="${r==cur?'a':''}">${esc(t('n_'+r))}</a>`).join('')}</nav><button class="lb" data-l aria-label="Language"><b class="${lang=='id'?'on':''}">ID</b> / <b class="${lang=='en'?'on':''}">EN</b></button><a class="btn sm" href="#contact">${esc(t('talk'))}</a><button class="hb" data-nav aria-label="Menu">☰</button></div></header><main>${V[cur]()}</main>
<footer><div class="lg">${E('brand')}</div><p>${E('tag')}</p><div class="lk">${R.map(r=>`<a href="#${r}">${esc(t('n_'+r))}</a>`).join('')}</div><div class="lk"><a href="${IG}" target="_blank" rel="noopener">Instagram</a><a href="${WA}" target="_blank" rel="noopener">WhatsApp</a><a href="mailto:${EM}">Email</a></div><small>${E('copy')}</small></footer>`;
 app.classList.toggle('edit',edit);
 if(edit)app.querySelectorAll('[data-k],[data-pp]').forEach(e=>{e.contentEditable='true';e.classList.add('ce')});
 const rv=app.querySelectorAll('.reveal');
 if(edit||!('IntersectionObserver' in window))rv.forEach(e=>e.classList.add('in'));else{const o=new IntersectionObserver(a=>a.forEach(x=>{if(x.isIntersecting){x.target.classList.add('in');o.unobserve(x.target)}}),{threshold:.1});rv.forEach(e=>o.observe(e))}
 bar();
}
function bar(){
 if(!owner){bar_.innerHTML='';return}
 const cur=location.hash.slice(1);
 bar_.innerHTML=edit?`<button class="btn" data-save>Save & Publish</button><button class="btn o" data-cancel>Cancel</button>${cur=='portfolio'?'<button class="btn o" data-add>+ Project</button>':''}<span style="${stErr?'color:#ff6b6b':''}">${esc(st||'Mengedit bahasa: '+lang.toUpperCase()+' — ganti bahasa di navbar untuk mengedit versi lainnya. Klik foto/logo untuk menggantinya.')}</span>`:`<button class="btn" data-edit>✎ Edit Website</button>${st?`<span>${esc(st)}</span>`:''}`;
}
function msg(s,err){st=s;stErr=!!err;bar()}
function pick(cb){const i=document.createElement('input');i.type='file';i.accept='image/jpeg,image/png,image/webp';i.onchange=()=>i.files[0]&&cb(i.files[0]);i.click()}
async function up(f,cb){
 if(!/^image\/(jpeg|png|webp)$/.test(f.type)){msg('Format harus JPG, PNG, atau WebP.',1);return}
 if(f.size>15e6){msg('Ukuran gambar maksimal 15 MB.',1);return}
 msg('Mengunggah gambar…');
 try{
  const a=await claude.use('assets');if(!a)throw new Error('Penyimpanan gambar tidak tersedia');
  const bm=await createImageBitmap(f),sc=Math.min(1,1400/Math.max(bm.width,bm.height)),cv=document.createElement('canvas');
  cv.width=Math.round(bm.width*sc);cv.height=Math.round(bm.height*sc);cv.getContext('2d').drawImage(bm,0,0,cv.width,cv.height);
  const bl=await new Promise(r=>cv.toBlob(r,'image/webp',.82));
  const r=await a.upload(bl);cb(r.url);msg('Gambar terunggah. Klik Save & Publish untuk menyimpan.');render();
 }catch(e){msg('Gagal mengunggah: '+(e.message||e.code||'error'),1)}
}
async function save(){
 msg('Menyimpan…');
 try{
  const a=await claude.use('artifact');if(!a)throw new Error('Penyimpanan tidak tersedia');
  const c=document.documentElement.cloneNode(true);
  ['#app','#bar','#md'].forEach(s=>c.querySelector(s).innerHTML='');
  c.querySelector('#data').textContent=JSON.stringify(S).replace(/</g,'\\u003c');
  await a.publish('<!doctype html>\n'+c.outerHTML);
  msg('Tersimpan.');
 }catch(e){msg('Gagal menyimpan (perubahan BELUM tersimpan): '+(e.message||e.code||'error'),1)}
}
document.addEventListener('click',e=>{
 const g=s=>e.target.closest(s),d=(s)=>{const x=g(s);return x&&x.dataset};
 if(g('[data-edit]')){edit=true;st='';render();return}
 if(g('[data-save]')){save();return}
 if(g('[data-cancel]')){S=JSON.parse(JSON.stringify(D));edit=false;st='';render();return}
 if(g('[data-add]')){S.p.push({title:'Project baru',cat:'graphic',year:String(new Date().getFullYear()),desc:'Deskripsi singkat karya.',img:''});render();return}
 if(g('[data-l]')){lang=lang=='id'?'en':'id';try{localStorage.setItem('l',lang)}catch(x){}render();return}
 if(g('[data-nav]')){open=!open;render();return}
 if(g('[data-f]')){flt=g('[data-f]').dataset.f;render();return}
 if(g('#md .x')||e.target===md){md.classList.remove('show');return}
 if(edit){
  if(g('a')&&(g('[data-k]')||g('[data-img]')))e.preventDefault();
  const im=g('[data-img]');if(im){const k=im.dataset.img;pick(f=>up(f,u=>S.img[k]=u));return}
  const pi=g('[data-pimg]');
